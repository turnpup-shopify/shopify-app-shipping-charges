# Shopify app (from the Dev Dashboard, per environment)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://freight-guard-staging.example.com
SCOPES=read_products,read_inventory,read_reports

# Neon Postgres (added by the Vercel Marketplace integration)
# Pooled, used by the app at runtime
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct, used by prisma migrate
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Protects /api/cron/scan and /api/scan/continue. Any long random string.
CRON_SECRET=

# Optional: stop starting new batches after this many ms (default 240000).
# Keep it about 60s under the function's maxDuration (300s).
# SCAN_TIME_BUDGET_MS=240000
