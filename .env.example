# Shopify app (from the Dev Dashboard, per environment)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://freight-guard-staging.example.com
SCOPES=read_products,read_inventory,read_reports,write_shipping

# Prisma Postgres (added by the Vercel Marketplace integration, which uses these names)
# Pooled, used by the app at runtime
DATABASE_URL_POOLED=postgres://user:pass@pooled.db.prisma.io:5432/postgres?sslmode=require
# Direct, used by prisma migrate
DATABASE_URL=postgres://user:pass@db.prisma.io:5432/postgres?sslmode=require

# Protects /api/cron/scan and /api/scan/continue. Any long random string.
CRON_SECRET=

# Daily email (Resend). Without RESEND_API_KEY the email is skipped.
RESEND_API_KEY=
NOTIFY_EMAIL=
# NOTIFY_FROM="Freight Margin Guard <alerts@your-domain.com>"
# SHOPIFY_APP_HANDLE=freight-margin-guard
# The freight shipping profile, by ID (survives renames). Default: the profile named "US Motor Freight".
# FREIGHT_PROFILE_ID=89594986703

# Optional: stop starting new batches after this many ms (default 240000).
# Keep it about 60s under the function's maxDuration (300s).
# SCAN_TIME_BUDGET_MS=240000
